# Copy to .env and fill in. .env is git-ignored.

# --- Claude API -----------------------------------------------------------
# Required only for --live runs. Without it the orchestrator runs in MOCK
# mode (canned agent responses from fixtures/sample_project/mock_llm/).
ANTHROPIC_API_KEY=

# Which model the agents call. Default is claude-opus-5.
# For a whole class running weekly, claude-sonnet-5 is ~5x cheaper per token
# and is usually good enough for this workload — set it here if budget matters.
PRODUCER_MODEL=claude-opus-5

# --- GitHub (only needed for --board github) ----------------------------
# A fine-grained PAT with read access to Issues and Contents on the team repo,
# plus write access to Issues if you use --apply to post the report as a comment.
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-game

# --- Discord (optional: post the weekly report to a channel) -----------
DISCORD_WEBHOOK_URL=
